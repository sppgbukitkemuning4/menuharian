rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin ditentukan oleh keberadaan dokumen adminEmails dengan ID = email admin.
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(
        /databases/$(database)/documents/adminEmails/$(request.auth.token.email)
      );
    }

    match /menus/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /adminEmails/{email} {
      // Pengguna hanya boleh memeriksa dokumen emailnya sendiri.
      // Admin boleh membaca daftar admin untuk fitur kelola email.
      allow get: if signedIn() && request.auth.token.email == email;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin()
        && request.resource.data.email == email;
    }

    match /otpSessions/{docId} {
      allow read, write: if false;
    }
  }
}
