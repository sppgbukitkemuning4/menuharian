rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin ditentukan dari dokumen adminEmails/{email}.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))
        && get(/databases/$(database)/documents/adminEmails/$(request.auth.token.email)).data.email == request.auth.token.email;
    }

    match /adminEmails/{email} {
      // Login hanya perlu membaca dokumen miliknya sendiri.
      // Ini mencegah daftar email admin terbuka untuk umum.
      allow get: if request.auth != null
                 && request.auth.token.email == email;

      // Daftar email hanya bisa dibaca oleh admin yang sudah terverifikasi.
      allow list: if isAdmin();

      // Hanya admin yang sudah terverifikasi yang boleh menambah/mengubah/menghapus.
      allow create, update, delete: if isAdmin();
    }

    match /menus/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
